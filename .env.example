# LearnAI Configuration
# Copy this file to .env and adjust values as needed.

# Gemini API Key (Optional: system automatically falls back to intelligent deterministic AI engine if not set)
GEMINI_API_KEY=

# Backend Host & Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database URL (SQLite)
DATABASE_URL=sqlite:///./learnai.db

# Storage directory for uploaded documents
UPLOAD_DIR=./data/uploads

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
