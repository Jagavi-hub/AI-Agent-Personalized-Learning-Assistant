# LearnAI Configuration
# Copy this file to .env and adjust values as needed.

# Gemini API Key (Optional: system automatically falls back to intelligent deterministic AI engine if not set)
GEMINI_API_KEY=

# Backend Host & Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database URL (SQLite)
DATABASE_URL=sqlite:///./learnai.db

# Storage directory for uploaded documents
UPLOAD_DIR=./data/uploads

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authorized Platform Administrators (comma-separated server allowlist)
ADMIN_EMAILS=jagavi.raju@university.edu,admin@learnai.edu

# Google OAuth 2.0 Client ID (Required for live Google Sign-In)
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Authorized JavaScript Origins: http://localhost:5173, http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
